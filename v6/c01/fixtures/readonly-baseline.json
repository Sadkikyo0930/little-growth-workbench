  "gate_predicate": {
    "function": "public.r5_gate_status_core(p_family_id, p_entry, p_ignore_override)",
    "prosrc_md5": "f78aceeba9c934fa8f4b5c754daba101",
    "prosecdef": true,
    "key_lines": {
      "3": "today_date date := timezone('Asia/Shanghai', clock_timestamp())::date;",
      "19_20": "SELECT day_index, subjects, published INTO plan FROM public.r5_daily_plan WHERE family_id = p_family_id AND study_date = today_date;",
      "21_24": "IF NOT FOUND OR NOT plan.published THEN all_pass := false; why := 'PLAN_UNPUBLISHED'; ELSIF jsonb_array_length(plan.subjects) = 0 THEN why := 'NO_TASKS_TODAY';",
      "28_35": "total_count/correct_count FROM growth_learning_records WHERE record_type='answer' AND subject=subject_name AND learning_day=plan.day_index AND left(answer.date,10)=today_date AND correct IN ('true','false');",
      "36_44": "finished := EXISTS(course-complete WHERE subject=subject_name AND learning_day=plan.day_index AND CASE WHEN completed_at ~ '^20[0-9]{2}-[0-9]{2}-[0-9]{2}T' THEN ((completed_at)::timestamptz AT TIME ZONE 'Asia/Shanghai')::date ELSE NULL END = today_date);",
      "45": "item_pass := finished AND total_count > 0 AND correct_count * 100 >= 80 * total_count;",
      "46_50": "IF NOT item_pass AND finished AND total_count = 0 THEN PERFORM 1 FROM public.r5_parent_waiver w WHERE w.family_id=p_family_id AND w.study_date=today_date AND w.subject=subject_name; IF FOUND THEN waived:=true; item_pass:=true; any_waived:=true; END IF; END IF;",
      "58_63": "evidence: SCORED / COMPLETED_UNSCORED_WAIVED / SCORED_BELOW_THRESHOLD / COMPLETED_UNSCORED / NOT_COMPLETED",
      "66_68": "why = STUDY_PASSED / STUDY_PASSED_WITH_WAIVER / STUDY_INCOMPLETE_OR_SCORE_UNVERIFIED",
      "70_80": "quota chain: r5_daily_usage -> used_seconds; limit_seconds := cfg.daily_seconds + cfg.bonus_seconds; remaining := greatest(0, limit_seconds - used_seconds); study_ok := (all_pass AND why <> 'PLAN_UNPUBLISHED') OR override_active; permitted := (NOT cfg.enabled OR study_ok) AND remaining > 0;",
      "81_85": "remaining=0 -> TIME_LIMIT_REACHED; NOT enabled -> PARENT_CONTROL_DISABLED; override -> STUDY_PASSED_WITH_WAIVER"
    }
  },
